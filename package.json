{
  "name": "project-list",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quick access and switching between projects.",
  "keywords": [
    "workspace",
    "switcher",
    "session",
    "manager",
    "glob"
  ],
  "repository": "https://github.com/lumine-code/project-list",
  "bugs": {
    "url": "https://github.com/lumine-code/project-list/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "specPackages": [
    "launcher"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "useCache": {
      "title": "Use cached data",
      "description": "Dump the project list to a cache file. Useful if scanning is used.",
      "type": "boolean",
      "default": true
    },
    "checkExists": {
      "title": "Existing items only",
      "description": "Add an item to the list only if at least one of its paths exists.",
      "type": "boolean",
      "default": true
    },
    "parseTitleTags": {
      "title": "Parse [tags] in titles",
      "description": "Parse and style [tag] patterns in project titles as tag elements.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "project-list": {
      "description": "Provides access to the project list manager",
      "versions": {
        "1.0.0": "provideProjectList"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#8e12afbf26aa2c937b801c3fbfa8fc67dc3a50e3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/fs-temp": "github:lumine-code/fs-temp#8f7934f3a35799302fd7938ff3e32549983111d8",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    }
  }
}
