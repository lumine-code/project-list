{
  "name": "project-list",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Quick access and switching between projects.",
  "keywords": [
    "workspace",
    "switcher",
    "session",
    "manager",
    "glob"
  ],
  "repository": "https://github.com/lumine-code/project-list",
  "bugs": {
    "url": "https://github.com/lumine-code/project-list/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can switch to another project with {{ 'project-list:toggle' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "useCache": {
      "title": "Use cached data",
      "description": "Dump the project list to a cache file. Useful if scanning is used.",
      "type": "boolean",
      "default": true
    },
    "checkExists": {
      "title": "Existing items only",
      "description": "Add an item to the list only if at least one of its paths exists.",
      "type": "boolean",
      "default": true
    },
    "parseTitleTags": {
      "title": "Parse [tags] in titles",
      "description": "Parse and style [tag] patterns in project titles as tag elements.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "project-list": {
      "description": "Provides access to the project list manager",
      "versions": {
        "1.0.0": "provideProjectList"
      }
    }
  },
  "consumedServices": {
    "open-external": {
      "versions": {
        "^1.0.0": "consumeOpenExternal"
      }
    }
  },
  "dependencies": {
    "@lumine-code/season": "github:lumine-code/season#ec9adb297202dd01a425113a4edc2c189d82c14e",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/temp": "github:lumine-code/node-temp#150772eb009638e11ed741bf8548aa74c8e5dd1c",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
