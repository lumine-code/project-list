{
  "atom-workspace": {
    "f10": "project-list:toggle",
    "ctrl-f10": "project-list:edit"
  },
  ".project-list atom-text-editor[mini]": {
    "alt-enter": "project-list:open-in-this-window",
    "shift-enter": "project-list:add-to-project",
    "alt-v": "project-list:insert-paths",
    "alt-d": "project-list:open-in-dev-mode",
    "alt-s": "project-list:open-in-safe-mode",
    "alt-f12": "project-list:open-external",
    "ctrl-f12": "project-list:show-in-folder",
    "f5": "project-list:refresh"
  }
}
